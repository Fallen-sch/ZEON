{
  "name": "zeon-vscode",
  "displayName": "ZEON Format",
  "description": "Syntax highlighting and preview for ZEON format",
  "version": "1.0.0",
  "license": "MIT",
  "publisher": "FallenBR",
  "icon": "icons/zeon-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Michael-Jhonathan/Zeon-website.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zeon"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zeon",
        "aliases": [
          "ZEON",
          "zeon"
        ],
        "extensions": [
          ".zeon"
        ],
        "icon": {
          "light": "./icons/zeon-logo.svg",
          "dark": "./icons/zeon-logo.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zeon",
        "scopeName": "source.zeon",
        "path": "./syntaxes/zeon.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zeon.showPreview",
        "title": "ZEON: Open Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == zeon",
          "command": "zeon.showPreview",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == zeon",
          "command": "zeon.showPreview",
          "group": "navigation"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "zeon-format": "^1.1.1"
  }
}
